{
  "name": "steam-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "smoke:realtime": "node scripts/realtime-smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:cloud": "node scripts/run-cloud-e2e.mjs",
    "test:e2e:defense:cloud": "node scripts/run-cloud-e2e.mjs --defense-only",
    "record:defense:cloud": "node scripts/run-cloud-e2e.mjs --record",
    "test:e2e:report": "playwright show-report ../output/playwright/html-report"
  },
  "dependencies": {
    "@lucide/vue": "^1.23.0",
    "@microsoft/signalr": "^10.0.11",
    "axios": "^1.7.9",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vue-tsc": "^2.1.10"
  }
}
